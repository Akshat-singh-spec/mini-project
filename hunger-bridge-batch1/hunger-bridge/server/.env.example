# Copy this file to ".env" and fill in real values before running the server.

# MySQL connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/hunger_bridge"

# Port the Express API listens on.
PORT=5000

# Secret used to sign JWT access tokens. Use a long random string in real deployments.
JWT_SECRET="replace_this_with_a_long_random_secret_key"

# How long an access token stays valid.
JWT_EXPIRES_IN="7d"

# Origin allowed to call this API (the Vite dev server by default).
CLIENT_ORIGIN="http://localhost:5173"

# Node environment.
NODE_ENV="development"
